{
  "name": "jordis-grid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/arodriguezrenda/jordis-grid",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "tsc && vite build && gh-pages -d dist"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-fast-marquee": "^1.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "typescript": "5.8.3",
    "vite": "^7.1.11"
  },
  "overrides": {
    "js-yaml": "4.1.1",
    "rollup": "4.60.0",
    "flatted": "3.4.2",
    "ajv": "6.14.0",
    "brace-expansion": "2.0.3",
    "picomatch": "2.3.2",
    "minimatch": "9.0.9",
    "vite": {
      "picomatch": "4.0.4"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.13"
    },
    "@eslint/eslintrc": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.13"
    },
    "eslint": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.13"
    }
  }
