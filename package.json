{
  "name": "jordis-grid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/arodriguezrenda/jordis-grid",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "tsc && vite build && node -e \"require('fs').writeFileSync('dist/deploy-marker.txt', new Date().toISOString())\" && gh-pages -d dist"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-fast-marquee": "^1.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "typescript": "5.8.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "rollup": "4.60.0",
    "flatted": "3.4.2",
    "ajv": "6.14.0",
    "brace-expansion": "2.1.4",
    "nanoid": "3.3.18",
    "picomatch": "4.0.4",
    "minimatch": "9.0.9",
    "vite": {
      "picomatch": "4.0.4"
    },
    "tinyglobby": {
      "picomatch": "4.0.4"
    },
    "@eslint/config-array": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@eslint/eslintrc": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    }
  }
}
